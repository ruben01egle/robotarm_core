{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run Robot",
            "type": "shell",
            "command": "source install/setup.bash && ros2 launch robot_bringup launch_robot.py",
            "problemMatcher": [],
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
