{
  "configurations": [
    {
      "browse": {
        "databaseFilename": "${default}",
        "limitSymbolsToIncludedHeaders": false
      },
      "includePath": [
        "${workspaceFolder}/**",
        "/opt/ros/jazzy/include/**",
        "${workspaceFolder}/install/interface/include/**",
        "${workspaceFolder}/build/interface/rosidl_generator_cpp/**",
        "/usr/include/**"
      ],
      "name": "ROS",
      "intelliSenseMode": "linux-gcc-x64",
      "compilerPath": "/usr/bin/gcc",
      "cStandard": "gnu11",
      "cppStandard": "c++17"
    }
  ],
  "version": 4
}