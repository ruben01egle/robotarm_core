<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robotarm_trajectory_smoothing</name>
  <version>0.1.0</version>
  <description>
    Jerk-limited smoothing (MoveIt's Ruckig smoothing) of whole joint trajectories as a service,
    for blended Pilz sequences whose blend zones the planning pipeline does not smooth.
  </description>
  <maintainer email="ruben01egle@gmail.com">Ruben Egle</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>moveit_core</depend>
  <depend>moveit_ros_planning</depend>
  <depend>trajectory_msgs</depend>
  <depend>robotarm_interface</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
