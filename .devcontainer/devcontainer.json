{
    "name": "Robotarm Dev Environment",
    "dockerComposeFile": [
        "../docker-compose.yml"
    ],
    "service": "robotarm_core",
    "workspaceFolder": "/ros2_ws/src",
    "runServices": ["robotarm_core"],
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-iot.vscode-ros"
            ]
        }
    },
    "remoteUser": "root"
}